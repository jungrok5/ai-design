{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/style/style_check.py\" --hook",
            "timeout": 15,
            "statusMessage": "Checking writing and UI style"
          }
        ]
      }
    ]
  }
}
